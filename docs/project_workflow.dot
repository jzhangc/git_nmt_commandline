digraph NMT_Project_Workflow {
  rankdir=TB;
  fontname="Helvetica";
  node [fontname="Helvetica", style=filled, shape=box, fontsize=12];
  edge [fontname="Helvetica", fontsize=10];

   // Main project root
   root [label="NMT Project", shape=folder, fillcolor="#e0e0e0", fontsize=16];

   // Top-level directories
   bash [label="*.sh Scripts\n(Entry Points)", fillcolor="#c8e6c9"];
   r_files [label="R_files/\n(ML Logic)", fillcolor="#bbdefb"];
   scripts_dir [label="scripts/\n(Init & Validation)", fillcolor="#fff9c4"];
   src_dir [label="src/\n(Utils & Vars)", fillcolor="#f8bbd0"];
   config_templates [label="config_file_templates/\n(Config Templates)", fillcolor="#e1bee7"];
   data_dir [label="data/\n(Sample Data)", fillcolor="#ffe0b2"];
   z_legacy [label="z_legacy/\n(Backed-up)", fillcolor="#ffcdd8"];
   docs [label="docs/\n(Diagrams)", fillcolor="#eceff1"];
   zzz [label="zzz\n(Shared Sourcing)", fillcolor="#d7ccc8"];

   root -> bash;
   root -> r_files;
   root -> scripts_dir;
   root -> src_dir;
   root -> config_templates;
   root -> data_dir;
   root -> z_legacy;
   root -> docs;
   root -> zzz;

    // z_legacy sub-folders
   legacy_config [label="config_file_templates/", fillcolor="#ffcdd8", parent=z_legacy];
   legacy_r_files [label="R_files/", fillcolor="#ffcdd8", parent=z_legacy];
   legacy_scripts [label="scripts/", fillcolor="#ffcdd8", parent=z_legacy];
   legacy_src [label="src/", fillcolor="#ffcdd8", parent=z_legacy];

   z_legacy -> legacy_config;
   z_legacy -> legacy_r_files;
   z_legacy -> legacy_scripts;
   z_legacy -> legacy_src;

    // data sub-folders
   data_conn [label="1_conn/\n(3D .mat connectivity)", fillcolor="#ffe0b2", parent=data_dir];
   data_tabular [label="2_tabular/\n(2D tabular data)", fillcolor="#ffe0b2", parent=data_dir];
   data_adhoc [label="3_adhoc_data/\n(Ad-hoc data)", fillcolor="#ffe0b2", parent=data_dir];
   data_archive [label="z_archive/\n(Archived old versions)", fillcolor="#ffe0b2", parent=data_dir];

   data_dir -> data_conn;
   data_dir -> data_tabular;
   data_dir -> data_adhoc;
   data_dir -> data_archive;

    // Style edges
   edge [color="#666666", arrowsize=0.8];
}
